<%- include('../partials/navbar') %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= errorMessage %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="text-center text-warning">Reset Your Password</h2>
          <p class="text-center">Enter your email, and we'll send you instructions to reset your password.</p>
          <form id="forgotPasswordForm" action="/auth/forgot-password" method="POST">
            <div class="mb-3">
              <label class="form-label">Email Address</label>
              <input type="email" name="email" class="form-control" required>
            </div>

            <!-- Google reCAPTCHA -->
            <div class="g-recaptcha" data-sitekey="<%= process.env.RECAPTCHA_SITE_KEY %>"></div>
            <p id="captchaError" class="text-danger d-none">Please verify that you are not a robot!</p>

            <button type="submit" class="btn btn-warning w-100 mt-3">Send Reset Link</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById("forgotPasswordForm").addEventListener("submit", function(event) {
    if (!grecaptcha.getResponse()) {
      document.getElementById("captchaError").classList.remove("d-none");
      event.preventDefault();
    }
  });
</script>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
